@database :memory:

# Regression coverage for `column_is_null_fold_safe` (tursodatabase/turso#4921):
# the NOT-NULL constant-fold must never fire on a column that an outer join
# can null-extend, even though the column's own schema says NOT NULL.
#
# The FULL OUTER JOIN cases also exercise the peek opcodes' hash-join
# cache-hit guard once the fold declines -- see hash-join-stale-cursor-peek.sqltest
# for that guard's dedicated, fold-independent test.

# --- LEFT JOIN: NOT NULL constraint on an outer-joined column ------------------
# `e.v` is NOT NULL, but the LEFT JOIN can still null-extend the whole row when
# there's no matching `p` row -- the constant-fold must not fire here.

test left-join-notnull-col-is-null-not-folded {
    CREATE TABLE p (id INTEGER PRIMARY KEY, n);
    CREATE TABLE e (id INTEGER PRIMARY KEY, pid, v TEXT NOT NULL);
    INSERT INTO p VALUES (1, 'p1'), (2, 'p2');
    INSERT INTO e VALUES (10, 1, 'x');

    SELECT p.n FROM p LEFT JOIN e ON e.pid = p.id WHERE e.v IS NULL;
}
expect {
    p2
}

test left-join-notnull-col-is-not-null-not-folded {
    CREATE TABLE p (id INTEGER PRIMARY KEY, n);
    CREATE TABLE e (id INTEGER PRIMARY KEY, pid, v TEXT NOT NULL);
    INSERT INTO p VALUES (1, 'p1'), (2, 'p2');
    INSERT INTO e VALUES (10, 1, 'x');

    SELECT p.n FROM p LEFT JOIN e ON e.pid = p.id WHERE e.v IS NOT NULL;
}
expect {
    p1
}

test left-join-notnull-col-count-not-folded {
    CREATE TABLE p (id INTEGER PRIMARY KEY, n);
    CREATE TABLE e (id INTEGER PRIMARY KEY, pid, v TEXT NOT NULL);
    INSERT INTO p VALUES (1, 'p1'), (2, 'p2');
    INSERT INTO e VALUES (10, 1, 'x');

    SELECT COUNT(e.v) FROM p LEFT JOIN e ON e.pid = p.id;
}
expect {
    1
}

# --- Self-join: same NOT NULL column, one side outer-joined -------------------
# Both sides reference the same table/column; only the outer-joined occurrence
# may be null-extended, so the fold must be decided per join-side, not per
# column identity alone.

test self-join-notnull-col-outer-side-not-folded {
    CREATE TABLE t (id INTEGER PRIMARY KEY, grp, v TEXT NOT NULL);
    INSERT INTO t VALUES (1, 'a', 'x'), (2, 'b', 'y');

    SELECT t1.v FROM t t1 LEFT JOIN t t2 ON t2.grp = 'nonexistent' AND t2.id = t1.id WHERE t2.v IS NULL ORDER BY t1.v;
}
expect {
    x
    y
}

test self-join-notnull-col-inner-side-still-folds-to-empty {
    CREATE TABLE t (id INTEGER PRIMARY KEY, grp, v TEXT NOT NULL);
    INSERT INTO t VALUES (1, 'a', 'x'), (2, 'b', 'y');

    SELECT t1.v FROM t t1 LEFT JOIN t t2 ON t2.grp = 'nonexistent' AND t2.id = t1.id WHERE t1.v IS NULL;
}
expect {
}

# --- CTE: NOT NULL column exposed through a derived table, outer-joined -------

test cte-notnull-col-outer-joined-not-folded {
    CREATE TABLE base (id INTEGER PRIMARY KEY, v TEXT NOT NULL);
    INSERT INTO base VALUES (1, 'x');
    WITH cte AS (SELECT id, v FROM base)
    SELECT p.n FROM (SELECT 1 AS id, 'p1' AS n UNION ALL SELECT 2, 'p2') p
        LEFT JOIN cte ON cte.id = p.id
        WHERE cte.v IS NULL
        ORDER BY p.n;
}
expect {
    p2
}

# --- FULL OUTER JOIN: NOT NULL constant-fold must not fire ---------------------

test full-outer-join-notnull-col-is-null-not-folded {
    CREATE TABLE t1 (id INTEGER PRIMARY KEY, k, a TEXT NOT NULL);
    CREATE TABLE t2 (id INTEGER PRIMARY KEY, k, b TEXT NOT NULL);
    INSERT INTO t1 VALUES (1, 10, 'x'), (2, 20, 'y');
    INSERT INTO t2 VALUES (1, 20, 'n'), (2, 30, 'p');

    SELECT t2.k FROM t1 FULL OUTER JOIN t2 ON t1.k = t2.k WHERE t1.a IS NULL;
}
expect {
    30
}

test full-outer-join-notnull-col-is-not-null-not-folded {
    CREATE TABLE t1 (id INTEGER PRIMARY KEY, k, a TEXT NOT NULL);
    CREATE TABLE t2 (id INTEGER PRIMARY KEY, k, b TEXT NOT NULL);
    INSERT INTO t1 VALUES (1, 10, 'x'), (2, 20, 'y');
    INSERT INTO t2 VALUES (1, 20, 'n'), (2, 30, 'p');

    SELECT t2.k FROM t1 FULL OUTER JOIN t2 ON t1.k = t2.k WHERE t1.a IS NOT NULL ORDER BY t2.k;
}
expect {

    20
}

test full-outer-join-notnull-col-count-correct {
    CREATE TABLE t1 (id INTEGER PRIMARY KEY, k, a TEXT NOT NULL);
    CREATE TABLE t2 (id INTEGER PRIMARY KEY, k, b TEXT NOT NULL);
    INSERT INTO t1 VALUES (1, 10, 'x'), (2, 20, 'y');
    INSERT INTO t2 VALUES (1, 20, 'n'), (2, 30, 'p');

    SELECT COUNT(t1.a) FROM t1 FULL OUTER JOIN t2 ON t1.k = t2.k;
}
expect {
    2
}

test full-outer-join-notnull-col-filter-correct {
    CREATE TABLE t1 (id INTEGER PRIMARY KEY, k, a TEXT NOT NULL);
    CREATE TABLE t2 (id INTEGER PRIMARY KEY, k, b TEXT NOT NULL);
    INSERT INTO t1 VALUES (1, 10, 'x'), (2, 20, 'y');
    INSERT INTO t2 VALUES (1, 20, 'n'), (2, 30, 'p');

    SELECT COUNT(*) FILTER (WHERE t1.a IS NULL) FROM t1 FULL OUTER JOIN t2 ON t1.k = t2.k;
}
expect {
    1
}

# `t2.b` is on the probe side here (t1 is build) -- confirms the guard is
# symmetric for the other table's NOT NULL column.
test full-outer-join-notnull-col-other-side-not-folded {
    CREATE TABLE t1 (id INTEGER PRIMARY KEY, k, a TEXT NOT NULL);
    CREATE TABLE t2 (id INTEGER PRIMARY KEY, k, b TEXT NOT NULL);
    INSERT INTO t1 VALUES (1, 10, 'x'), (2, 20, 'y');
    INSERT INTO t2 VALUES (1, 20, 'n'), (2, 30, 'p');

    SELECT t1.k FROM t1 FULL OUTER JOIN t2 ON t1.k = t2.k WHERE t2.b IS NULL ORDER BY t1.k;
}
expect {
    10
}

# --- Plain single-table queries: the fold must actually fire here -------------
# Everything above tests the fold correctly declining. These confirm it still
# does its job in the ordinary case it targets: no join, so nothing can
# null-extend `v`, and it's schema NOT NULL.

test single-table-notnull-col-is-null-folds-to-false {
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT NOT NULL);
    INSERT INTO t VALUES (1, 'x'), (2, 'y');

    SELECT id FROM t WHERE v IS NULL;
}
expect {
}

test single-table-notnull-col-is-not-null-folds-to-true {
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT NOT NULL);
    INSERT INTO t VALUES (1, 'x'), (2, 'y');

    SELECT id FROM t WHERE v IS NOT NULL ORDER BY id;
}
expect {
    1
    2
}

test single-table-count-notnull-col-equals-count-star {
    CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT NOT NULL);
    INSERT INTO t VALUES (1, 'x'), (2, 'y'), (3, 'z');

    SELECT COUNT(v) FROM t;
}
expect {
    3
}

# --- UPDATE ... FROM: WHERE folding must use the full target+FROM scope -------
# Regression test: `plan.where_clause` for `UPDATE ... FROM` is bound against
# both the target and FROM-side tables, so the fold's `is_nonnull` lookup must
# see that same combined scope. Using only the target table's scope here
# previously panicked with "table not found" as soon as the WHERE clause did
# `IS [NOT] NULL` on a FROM-side column.

test update-from-where-is-null-on-from-side-notnull-column {
    CREATE TABLE t1 (id INTEGER PRIMARY KEY, x INTEGER);
    CREATE TABLE t2 (id INTEGER PRIMARY KEY, notnull_col TEXT NOT NULL);
    INSERT INTO t1 VALUES (1, 0);
    INSERT INTO t2 VALUES (1, 'present');

    UPDATE t1 SET x = 1 FROM t2 WHERE t2.notnull_col IS NULL;
    SELECT x FROM t1;
}
expect {
    0
}

test update-from-where-is-not-null-on-from-side-notnull-column {
    CREATE TABLE t1 (id INTEGER PRIMARY KEY, x INTEGER);
    CREATE TABLE t2 (id INTEGER PRIMARY KEY, notnull_col TEXT NOT NULL);
    INSERT INTO t1 VALUES (1, 0);
    INSERT INTO t2 VALUES (1, 'present');

    UPDATE t1 SET x = 1 FROM t2 WHERE t1.id = t2.id AND t2.notnull_col IS NOT NULL;
    SELECT x FROM t1;
}
expect {
    1
}
